# Multi-user Supabase (the NEW project — not your personal one).
# Copy to .env and fill in from Supabase → Project Settings → API.
# When these are BLANK, the app runs in local-only mode (no sign-in, progress in
# localStorage). When set, auth + per-user cloud sync switch on.
#
# The anon key is safe to ship in the client because RLS scopes every row to the
# signed-in user. NEVER put the service_role key here.
# A connected desktop build also requires the Supabase email templates described
# in docs/AUTH_AND_DISTRIBUTION.md so the Tauri app receives a six-digit code.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: show the "Continue with Google" button. Leave unset for email-only
# sign-in (no Google Cloud setup needed). Set to "true" once Google OAuth is
# configured in Supabase → Authentication → Providers.
VITE_ENABLE_GOOGLE=

# Required only for optional local MCP HTTP mode. Stdio needs no token.
# Supply a long runtime-only value; never commit the filled value.
SOUPZ_MCP_TOKEN=
